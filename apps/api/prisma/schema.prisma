// Esquema base del dominio. Convenciones (ver docs/database.md):
//  - Identificadores: UUID v7 generados por Prisma (ordenables por tiempo).
//  - Instantes: timestamptz en UTC. Fechas de calendario (temporadas): date.
//  - Tablas y columnas en snake_case; modelos y campos en camelCase.
//  - Sin borrado físico de datos con trazabilidad: se desactivan por estado y
//    las claves foráneas hacia ellos usan ON DELETE RESTRICT.
//  - Las restricciones CHECK y los triggers viven en el SQL de cada migración.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Estados ─────────────────────────────

enum UserStatus {
  /// Creada por un administrador; aún sin contraseña (espera su activación).
  pendiente
  activo
  inactivo
  bloqueado

  @@map("user_status")
}

/// Estado de los catálogos configurables (deportes, categorías).
enum CatalogStatus {
  activo
  inactivo

  @@map("catalog_status")
}

enum SeasonStatus {
  borrador
  activa
  finalizada
  archivada

  @@map("season_status")
}

/// Motivo por el que una sesión dejó de ser válida.
enum SessionRevocationReason {
  cierre_sesion
  reemplazada
  revocada_por_usuario
  revocada_por_administrador
  cuenta_desactivada
  contrasena_cambiada

  @@map("session_revocation_reason")
}

enum CredentialTokenKind {
  /// Primer establecimiento de contraseña de una cuenta pendiente.
  activacion
  /// Nueva contraseña para una cuenta activa (olvido, sospecha de compromiso).
  restablecimiento

  @@map("credential_token_kind")
}

/// Clave por la que se cuentan los intentos de acceso fallidos.
enum LoginFailureScope {
  ip
  cuenta_ip
  cuenta

  @@map("login_failure_scope")
}

// ───────────────────── Usuarios, roles y permisos ─────────────────────

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas (CHECK en la migración).
  email        String     @unique
  displayName  String     @map("display_name")
  /// Hash Argon2id. Nulo mientras la cuenta está pendiente de activación.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(activo)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                  UserRole[]        @relation("UserRoles")
  grantedRoles           UserRole[]        @relation("UserRoleGrantedBy")
  auditLogs              AuditLog[]
  sessions               Session[]
  credentialTokens       CredentialToken[] @relation("CredentialTokenOwner")
  issuedCredentialTokens CredentialToken[] @relation("CredentialTokenIssuer")
  clubLinks              ClubUser[]        @relation("ClubUserMember")
  createdClubLinks       ClubUser[]        @relation("ClubUserCreator")
  recordedConsents       ConsentRecord[]
  teamMembershipsCreated TeamMembership[]
  createdFiles           StoredFile[]      @relation("StoredFileCreator")
  verifiedDocuments      AthleteDocument[] @relation("DocumentVerifier")
  approvedRuleVersions   CompetitionRuleVersion[] @relation("RuleVersionApprover")
  reviewedRegistrations  Registration[]    @relation("RegistrationReviewer")
  submittedResults       Result[]          @relation("ResultSubmitter")
  approvedResults        Result[]          @relation("ResultApprover")
  resultRevisions        ResultRevision[]  @relation("ResultRevisionAuthor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Identificador estable usado por el código (ej. "superadmin").
  code        String   @unique
  name        String
  description String?
  /// Los roles de sistema no pueden eliminarse desde la aplicación.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo de permisos. Lo define el código (cada permiso corresponde a una
/// comprobación en el backend) y se sincroniza con `db:seed`.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Formato `recurso:acción`, ej. "seasons:create".
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Asignación de un rol a un usuario. Tiene clave propia para poder añadir
/// después un alcance organizativo (p. ej. club) sin rehacer la tabla.
model UserRole {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@map("user_roles")
}

// ───────────────────────────── Sesiones ─────────────────────────────

/// Sesión de servidor. El navegador solo conoce un identificador opaco; aquí se
/// guarda su hash SHA-256, de modo que una filtración de la base de datos no
/// permite suplantar sesiones. El token CSRF está ligado a la sesión.
model Session {
  id               String                   @id @default(uuid(7)) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  /// SHA-256 (hex) del identificador entregado en la cookie.
  tokenHash        String                   @unique @map("token_hash")
  csrfToken        String                   @map("csrf_token")
  userAgent        String?                  @map("user_agent")
  /// Hash con clave de la IP (nunca en claro).
  ipHash           String?                  @map("ip_hash")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime                 @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Caducidad absoluta: no se renueva con la actividad.
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason SessionRevocationReason? @map("revocation_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Intentos de acceso fallidos recientes, para limitar la fuerza bruta. Se
/// guarda en PostgreSQL para que un reinicio no los borre y para que funcione
/// con varias instancias de la API. `keyHash` es un hash con clave.
model LoginFailure {
  id        String            @id @default(uuid(7)) @db.Uuid
  scope     LoginFailureScope
  keyHash   String            @map("key_hash")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
  @@map("login_failures")
}

/// Enlace de un solo uso para establecer una contraseña. Solo se guarda el SHA-256
/// del token (el valor en claro se entrega una vez al administrador que lo emite).
model CredentialToken {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  kind        CredentialTokenKind
  tokenHash   String              @unique @map("token_hash")
  /// Administrador que lo emitió.
  createdById String?             @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(3)
  /// Momento en que se usó para establecer la contraseña.
  usedAt      DateTime?           @map("used_at") @db.Timestamptz(3)
  /// Anulado por una emisión posterior, un cambio de contraseña o una desactivación.
  revokedAt   DateTime?           @map("revoked_at") @db.Timestamptz(3)

  user      User  @relation("CredentialTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CredentialTokenIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, usedAt, revokedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@map("credential_tokens")
}

// ───────────────────────────── Auditoría ─────────────────────────────

/// Registro inmutable de operaciones sensibles (un trigger impide UPDATE/DELETE).
/// `userId` es nulo para acciones del sistema o de actores no autenticados.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  /// Operación en formato `recurso.acción`, ej. "result.approve".
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  beforeSnapshot Json?    @map("before_snapshot")
  afterSnapshot  Json?    @map("after_snapshot")
  reason         String?
  /// Hash de la IP, nunca la IP en claro.
  ipHash         String?  @map("ip_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────── Catálogos y temporadas ─────────────────────

model Sport {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  name      String        @unique
  status    CatalogStatus @default(activo)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  teams         Team[]
  teamSeasons   TeamSeason[]
  championships Championship[]

  @@map("sports")
}

/// Categoría o división institucional (Liga A, Juvenil, Niños…). Se configura
/// desde el sistema; el rango de edad es opcional porque la Liga aún debe
/// confirmarlo. No pertenece a un deporte concreto: la relación se establece
/// en el campeonato.
model Category {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  name      String        @unique
  ageMin    Int?          @map("age_min")
  ageMax    Int?          @map("age_max")
  sortOrder Int           @default(0) @map("sort_order")
  status    CatalogStatus @default(activo)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  teamSeasons   TeamSeason[]
  championships Championship[]

  @@map("categories")
}

model Season {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String       @unique
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    SeasonStatus @default(borrador)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  teamSeasons   TeamSeason[]
  memberships   TeamMembership[]
  championships Championship[]

  @@index([status])
  @@map("seasons")
}

// ───────────────────── Clubes, personas y deportistas ─────────────────────

enum ClubStatus {
  activo
  inactivo
  suspendido
  archivado

  @@map("club_status")
}

enum PersonStatus {
  activo
  inactivo

  @@map("person_status")
}

enum IdType {
  cedula
  pasaporte
  otro

  @@map("id_type")
}

/// Habilitación del deportista. La decide quien valida (no el club que lo inscribe).
enum AthleteEligibility {
  pendiente
  habilitado
  inhabilitado

  @@map("athlete_eligibility")
}

enum ConsentType {
  /// Publicar el perfil resumido en el portal público.
  publicacion_perfil
  /// Publicar la fotografía en el portal público.
  publicacion_foto
  /// Tratamiento de datos personales para la gestión deportiva.
  tratamiento_datos

  @@map("consent_type")
}

enum ConsentStatus {
  otorgado
  revocado

  @@map("consent_status")
}

model Club {
  id           String     @id @default(uuid(7)) @db.Uuid
  name         String
  /// Nombre normalizado (minúsculas, sin tildes ni signos): evita duplicados evidentes.
  nameKey      String     @unique @map("name_key")
  /// Identificador público estable para las direcciones del portal.
  slug         String     @unique
  shortName    String?    @map("short_name")
  /// Código institucional, si existe.
  code         String?    @unique
  sector       String?
  contactEmail String?    @map("contact_email")
  contactPhone String?    @map("contact_phone")
  status       ClubStatus @default(activo)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           ClubUser[]
  representatives ClubRepresentative[]
  athletes        Athlete[]
  teams           Team[]

  @@map("clubs")
}

/// Alcance por club: un usuario sin el permiso `clubs:access_all` solo ve y gestiona
/// los clubes con los que tiene un vínculo aquí. Los permisos dicen QUÉ puede hacer;
/// este vínculo dice EN QUÉ clubes.
model ClubUser {
  clubId      String   @map("club_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User  @relation("ClubUserMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ClubUserCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([clubId, userId])
  @@index([userId])
  @@index([createdById])
  @@map("club_users")
}

/// Identidad básica de una persona. Los datos de contacto e identificación viven en
/// `person_private_data`, con acceso restringido.
model Person {
  id        String       @id @default(uuid(7)) @db.Uuid
  firstName String       @map("first_name")
  lastName  String       @map("last_name")
  /// Necesaria para validar la categoría. Nunca se publica.
  birthDate DateTime?    @map("birth_date") @db.Date
  status    PersonStatus @default(activo)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  privateData     PersonPrivateData?
  athlete         Athlete?
  consents        ConsentRecord[]
  representations ClubRepresentative[]

  @@map("persons")
}

model PersonPrivateData {
  personId         String   @id @map("person_id") @db.Uuid
  idType           IdType?  @map("id_type")
  idNumber         String?  @map("id_number")
  /// `tipo:número` normalizado. Único: impide registrar dos veces a la misma persona.
  idKey            String?  @unique @map("id_key")
  phone            String?
  guardianName     String?  @map("guardian_name")
  guardianRelation String?  @map("guardian_relation")
  guardianPhone    String?  @map("guardian_phone")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_private_data")
}

model ClubRepresentative {
  id         String    @id @default(uuid(7)) @db.Uuid
  clubId     String    @map("club_id") @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  /// Cargo: representante, delegado, presidente…
  roleName   String    @map("role_name")
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([clubId, validUntil])
  @@index([personId])
  @@map("club_representatives")
}

model Athlete {
  id            String             @id @default(uuid(7)) @db.Uuid
  personId      String             @unique @map("person_id") @db.Uuid
  /// Club que lo tiene registrado. Solo cambia al terminar la temporada (transferencia).
  clubId        String             @map("club_id") @db.Uuid
  /// Número correlativo para el código interno visible (DEP-000123).
  codeNumber    Int                @unique @default(autoincrement()) @map("code_number")
  eligibility   AthleteEligibility @default(pendiente)
  /// El perfil resumido es público solo si esta marca está activa Y hay consentimiento vigente.
  publicProfile Boolean            @default(false) @map("public_profile")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  memberships    TeamMembership[]
  photo          AthletePhoto?
  documents      AthleteDocument[]
  participant    IndividualParticipant?
  footballEvents FootballEvent[]

  @@index([clubId])
  @@map("athletes")
}

/// Consentimientos de tratamiento y publicación. Si el titular es menor, lo otorga su
/// tutor (`grantedByRelation`). Los registros no se borran: se revocan.
model ConsentRecord {
  id                String        @id @default(uuid(7)) @db.Uuid
  personId          String        @map("person_id") @db.Uuid
  type              ConsentType
  status            ConsentStatus @default(otorgado)
  purpose           String?
  /// Quién otorgó el consentimiento (la propia persona o su tutor).
  grantedByName     String        @map("granted_by_name")
  /// «propio» o el parentesco del tutor (madre, padre, tutor legal…).
  grantedByRelation String        @map("granted_by_relation")
  recordedAt        DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?       @map("revoke_reason")
  recordedById      String        @map("recorded_by_id") @db.Uuid

  person     Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  recordedBy User   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([personId, type, status])
  @@index([recordedById])
  @@map("consent_records")
}

// ───────────────────── Equipos y plantillas ─────────────────────

enum MembershipStatus {
  activo
  baja

  @@map("membership_status")
}

/// Un equipo de un club en un deporte. `name` es el nombre por defecto para nuevas
/// temporadas; el nombre vigente en cada temporada vive en `TeamSeason.name`, de modo
/// que un equipo puede llamarse distinto de una temporada a otra sin perder el historial.
model Team {
  id        String        @id @default(uuid(7)) @db.Uuid
  clubId    String        @map("club_id") @db.Uuid
  sportId   String        @map("sport_id") @db.Uuid
  name      String
  nameKey   String        @map("name_key")
  status    CatalogStatus @default(activo)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  sport       Sport            @relation(fields: [sportId], references: [id], onDelete: Restrict)
  seasons     TeamSeason[]
  participant TeamParticipant?

  @@unique([clubId, sportId, nameKey])
  @@unique([id, sportId])
  @@index([sportId])
  @@map("teams")
}

/// Inscripción de un equipo en una temporada, con su nombre y categoría de ese período.
/// `sportId` se repite aquí (clave compuesta con `Team`) para que la base de datos pueda
/// garantizar «un deportista, un equipo por deporte y temporada».
model TeamSeason {
  id           String   @id @default(uuid(7)) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  sportId      String   @map("sport_id") @db.Uuid
  seasonId     String   @map("season_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  nameKey      String   @map("name_key")
  /// Con la plantilla cerrada no se admiten altas (las bajas siguen permitidas).
  rosterClosed Boolean  @default(false) @map("roster_closed")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team        Team             @relation(fields: [teamId, sportId], references: [id, sportId], onDelete: Restrict)
  sport       Sport            @relation(fields: [sportId], references: [id], onDelete: Restrict)
  season      Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberships TeamMembership[]

  @@unique([teamId, seasonId])
  /// Dos equipos del mismo deporte no pueden llamarse igual en una misma temporada.
  @@unique([seasonId, sportId, nameKey])
  @@unique([id, sportId, seasonId])
  @@index([seasonId])
  @@index([categoryId])
  @@index([sportId])
  @@map("team_seasons")
}

/// Pertenencia de un deportista a la plantilla de un equipo en una temporada.
/// REGLA: un deportista solo puede estar en un equipo por deporte y temporada (puede
/// estar en varios deportes). La causa la garantiza la restricción única
/// (athlete_id, sport_id, season_id). Una baja NO libera el cupo; solo la anulación
/// (permiso `teams:delete`) lo hace.
model TeamMembership {
  id           String           @id @default(uuid(7)) @db.Uuid
  teamSeasonId String           @map("team_season_id") @db.Uuid
  athleteId    String           @map("athlete_id") @db.Uuid
  sportId      String           @map("sport_id") @db.Uuid
  seasonId     String           @map("season_id") @db.Uuid
  status       MembershipStatus @default(activo)
  jerseyNumber Int?             @map("jersey_number")
  joinedAt     DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt       DateTime?        @map("left_at") @db.Timestamptz(3)
  leaveReason  String?          @map("leave_reason")
  createdById  String           @map("created_by_id") @db.Uuid

  teamSeason TeamSeason @relation(fields: [teamSeasonId, sportId, seasonId], references: [id, sportId, seasonId], onDelete: Restrict)
  season     Season     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  athlete    Athlete    @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([athleteId, sportId, seasonId])
  @@index([teamSeasonId])
  @@index([seasonId])
  @@index([createdById])
  @@map("team_memberships")
}

// ───────────────────── Archivos y documentos ─────────────────────

enum DocumentType {
  identificacion
  certificado_medico
  formulario_inscripcion
  otro

  @@map("document_type")
}

/// Almacenamiento seguro de archivos. El archivo real vive en el sistema de
/// archivos fuera de la raíz web, con nombre aleatorio opaco.
model StoredFile {
  id             String   @id @default(uuid(7)) @db.Uuid
  filename       String   @unique
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  checksumSha256 String   @map("checksum_sha256")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String   @map("created_by_id") @db.Uuid

  createdBy    User             @relation("StoredFileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  athletePhoto AthletePhoto?
  athleteDoc   AthleteDocument?

  @@index([createdById])
  @@map("stored_files")
}

/// Fotografía de un deportista. Se publica solo con consentimiento vigente y perfil publicado.
model AthletePhoto {
  athleteId String   @id @map("athlete_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  athlete Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@map("athlete_photos")
}

/// Documento de inscripción o respaldo de un deportista.
model AthleteDocument {
  id           String       @id @default(uuid(7)) @db.Uuid
  athleteId    String       @map("athlete_id") @db.Uuid
  fileId       String       @unique @map("file_id") @db.Uuid
  type         DocumentType
  title        String
  verified     Boolean      @default(false)
  verifiedAt   DateTime?    @map("verified_at") @db.Timestamptz(3)
  verifiedById String?      @map("verified_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  athlete    Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  verifiedBy User?      @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([athleteId])
  @@index([verifiedById])
  @@map("athlete_documents")
}

// ───────────────────── Campeonatos, competencias y participantes ─────────────────────

enum ChampionshipFormat {
  todos_contra_todos
  eliminatoria_simple
  fase_grupos_y_eliminatoria
  sistema_suizo
  cuadro_combates

  @@map("championship_format")
}

enum ChampionshipStatus {
  borrador
  inscripciones_abiertas
  inscripciones_cerradas
  en_curso
  finalizado
  archivado

  @@map("championship_status")
}

enum ParticipantKind {
  equipo
  individual

  @@map("participant_kind")
}

enum RegistrationStatus {
  borrador
  pendiente
  observada
  aprobada
  rechazada
  retirada

  @@map("registration_status")
}

enum StageType {
  grupo
  eliminatoria
  unico

  @@map("stage_type")
}

enum EventStatus {
  programado
  en_curso
  finalizado
  suspendido
  postergado
  cancelado

  @@map("event_status")
}

enum ParticipantSide {
  local
  visitante
  individual

  @@map("participant_side")
}

enum ResultStatus {
  borrador
  pendiente_revision
  aprobado
  rechazado
  anulado

  @@map("result_status")
}

enum ResultOutcome {
  victoria
  empate
  derrota
  no_presentado

  @@map("result_outcome")
}

enum FootballEventType {
  gol
  tarjeta_amarilla
  tarjeta_roja
  sustitucion

  @@map("football_event_type")
}

enum ChessColor {
  blancas
  negras

  @@map("chess_color")
}

/// Escenarios deportivos (canchas, coliseos, estadios, mesas).
model Venue {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String        @unique
  address   String?
  capacity  Int?
  status    CatalogStatus @default(activo)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  events Event[]

  @@map("venues")
}

/// Campeonato deportivo: edición de competencia en una temporada, deporte y categoría.
model Championship {
  id                String             @id @default(uuid(7)) @db.Uuid
  seasonId          String             @map("season_id") @db.Uuid
  sportId           String             @map("sport_id") @db.Uuid
  categoryId        String             @map("category_id") @db.Uuid
  name              String
  format            ChampionshipFormat
  status            ChampionshipStatus @default(borrador)
  registrationStart DateTime?          @map("registration_start") @db.Date
  registrationEnd   DateTime?          @map("registration_end") @db.Date
  startDate         DateTime?          @map("start_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  season        Season                   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  sport         Sport                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  category      Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ruleVersions  CompetitionRuleVersion[]
  registrations Registration[]
  stages        Stage[]

  @@unique([seasonId, sportId, categoryId, name])
  @@index([seasonId])
  @@index([sportId])
  @@index([categoryId])
  @@index([status])
  @@map("championships")
}

/// Reglamento versionado y aprobado para un campeonato (puntos, desempates, reglas).
model CompetitionRuleVersion {
  id             String    @id @default(uuid(7)) @db.Uuid
  championshipId String    @map("championship_id") @db.Uuid
  version        Int
  rulesJson      Json      @map("rules_json")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("RuleVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([championshipId, version])
  @@index([approvedById])
  @@map("competition_rule_versions")
}

/// Entidad común de participantes (ADR-001).
model Participant {
  id        String          @id @default(uuid(7)) @db.Uuid
  kind      ParticipantKind
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  team          TeamParticipant?
  individual    IndividualParticipant?
  registrations Registration[]

  @@unique([id, kind])
  @@map("participants")
}

/// Participante de tipo equipo (ADR-001).
model TeamParticipant {
  participantId String          @id @map("participant_id") @db.Uuid
  kind          ParticipantKind @default(equipo)
  teamId        String          @unique @map("team_id") @db.Uuid

  participant Participant @relation(fields: [participantId, kind], references: [id, kind], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([participantId, kind])
  @@map("team_participants")
}

/// Participante de tipo individual (ADR-001).
model IndividualParticipant {
  participantId String          @id @map("participant_id") @db.Uuid
  kind          ParticipantKind @default(individual)
  athleteId     String          @unique @map("athlete_id") @db.Uuid

  participant Participant @relation(fields: [participantId, kind], references: [id, kind], onDelete: Cascade)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@unique([participantId, kind])
  @@map("individual_participants")
}

/// Inscripción de un participante en un campeonato concreto.
model Registration {
  id             String             @id @default(uuid(7)) @db.Uuid
  championshipId String             @map("championship_id") @db.Uuid
  participantId  String             @map("participant_id") @db.Uuid
  status         RegistrationStatus @default(pendiente)
  notes          String?
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNotes    String?            @map("review_notes")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  championship      Championship       @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  participant       Participant        @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  eventParticipants EventParticipant[]

  @@unique([championshipId, participantId])
  @@index([participantId])
  @@index([status])
  @@index([reviewedById])
  @@map("registrations")
}

/// Etapa de un campeonato (fase de grupos, eliminación, etapa única).
model Stage {
  id             String        @id @default(uuid(7)) @db.Uuid
  championshipId String        @map("championship_id") @db.Uuid
  name           String
  stageType      StageType     @default(grupo) @map("stage_type")
  sequence       Int           @default(1)
  status         CatalogStatus @default(activo)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  rounds       Round[]

  @@unique([championshipId, sequence])
  @@index([championshipId])
  @@map("stages")
}

/// Jornada o ronda de una etapa.
model Round {
  id          String        @id @default(uuid(7)) @db.Uuid
  stageId     String        @map("stage_id") @db.Uuid
  roundNumber Int           @default(1) @map("round_number")
  name        String
  status      CatalogStatus @default(activo)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage  Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([stageId, roundNumber])
  @@index([stageId])
  @@map("rounds")
}

/// Encuentro o partido deportivo.
model Event {
  id                 String      @id @default(uuid(7)) @db.Uuid
  roundId            String      @map("round_id") @db.Uuid
  venueId            String?     @map("venue_id") @db.Uuid
  scheduledAt        DateTime?   @map("scheduled_at") @db.Timestamptz(3)
  actualStartAt      DateTime?   @map("actual_start_at") @db.Timestamptz(3)
  actualEndAt        DateTime?   @map("actual_end_at") @db.Timestamptz(3)
  status             EventStatus @default(programado)
  postponementReason String?     @map("postponement_reason")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  round        Round              @relation(fields: [roundId], references: [id], onDelete: Restrict)
  venue        Venue?             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  participants EventParticipant[]
  result       Result?

  @@index([roundId])
  @@index([venueId, scheduledAt])
  @@index([scheduledAt])
  @@index([status])
  @@map("events")
}

/// Participante en un encuentro deportivo.
model EventParticipant {
  id             String          @id @default(uuid(7)) @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  registrationId String          @map("registration_id") @db.Uuid
  side           ParticipantSide @default(individual)
  seed           Int?

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  resultValues   ResultValue[]
  periodScores   EventPeriodScore[]
  footballEvents FootballEvent[]
  taekwondoBouts TaekwondoBout[]
  chessPairings  ChessPairing[]

  @@unique([eventId, registrationId])
  @@index([registrationId])
  @@map("event_participants")
}

/// Resultado oficial y acta de un encuentro deportivo.
model Result {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventId       String       @unique @map("event_id") @db.Uuid
  status        ResultStatus @default(borrador)
  submittedById String?      @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz(3)
  approvedById  String?      @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvalNotes String?      @map("approval_notes")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submittedBy    User?              @relation("ResultSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy     User?              @relation("ResultApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  values         ResultValue[]
  revisions      ResultRevision[]
  periodScores   EventPeriodScore[]
  footballEvents FootballEvent[]
  taekwondoBouts TaekwondoBout[]
  chessPairings  ChessPairing[]

  @@index([status])
  @@index([submittedById])
  @@index([approvedById])
  @@map("results")
}

/// Puntuación y resultado de cada participante en el evento.
model ResultValue {
  id                 String        @id @default(uuid(7)) @db.Uuid
  resultId           String        @map("result_id") @db.Uuid
  eventParticipantId String        @map("event_participant_id") @db.Uuid
  score              Int           @default(0)
  outcome            ResultOutcome @default(empate)
  rank               Int?

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)

  @@unique([resultId, eventParticipantId])
  @@map("result_values")
}

/// Historial inmutable de modificaciones y revisiones de un resultado.
model ResultRevision {
  id               String   @id @default(uuid(7)) @db.Uuid
  resultId         String   @map("result_id") @db.Uuid
  previousSnapshot Json     @map("previous_snapshot")
  newSnapshot      Json     @map("new_snapshot")
  reason           String
  changedById      String   @map("changed_by_id") @db.Uuid
  changedAt        DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  result    Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  changedBy User   @relation("ResultRevisionAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([resultId])
  @@index([changedById])
  @@map("result_revisions")
}

/// Incidencias y estadísticas de fútbol (goles, tarjetas, sustituciones).
model FootballEvent {
  id                 String            @id @default(uuid(7)) @db.Uuid
  resultId           String            @map("result_id") @db.Uuid
  eventParticipantId String            @map("event_participant_id") @db.Uuid
  athleteId          String?           @map("athlete_id") @db.Uuid
  eventType          FootballEventType @map("event_type")
  minute             Int
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)
  athlete          Athlete?         @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([resultId])
  @@index([athleteId])
  @@map("football_events")
}

/// Puntuación por período (Básquet: Q1..Q4, OT).
model EventPeriodScore {
  id                 String @id @default(uuid(7)) @db.Uuid
  resultId           String @map("result_id") @db.Uuid
  eventParticipantId String @map("event_participant_id") @db.Uuid
  periodNumber       Int    @map("period_number")
  score              Int

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)

  @@unique([resultId, eventParticipantId, periodNumber])
  @@map("event_period_scores")
}

/// Asaltos y puntos de combate (Taekwondo).
model TaekwondoBout {
  id                 String  @id @default(uuid(7)) @db.Uuid
  resultId           String  @map("result_id") @db.Uuid
  eventParticipantId String  @map("event_participant_id") @db.Uuid
  roundNumber        Int     @map("round_number")
  points             Int
  penalties          Int     @default(0)
  decision           String?

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("taekwondo_bouts")
}

/// Emparejamiento individual y puntuación (Ajedrez: 1.0, 0.5, 0.0, Buchholz).
model ChessPairing {
  id                 String     @id @default(uuid(7)) @db.Uuid
  resultId           String     @map("result_id") @db.Uuid
  eventParticipantId String     @map("event_participant_id") @db.Uuid
  color              ChessColor
  points             Decimal    @db.Decimal(3, 1)
  buchholz           Decimal?   @db.Decimal(5, 2)

  result           Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("chess_pairings")
}

