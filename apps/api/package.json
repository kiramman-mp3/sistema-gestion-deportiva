{
  "name": "@liga/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "nest build && node dist/database/seed.cli.js",
    "db:seed:provisional": "nest build && node dist/database/seed-provisional.cli.js",
    "admin:create-superadmin": "nest build && node dist/auth/bootstrap-superadmin.cli.js",
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prelint": "npm run db:generate",
    "lint": "oxlint --type-aware src/ test/",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run db:generate",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie": "1.1.1",
    "helmet": "^8.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.18.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
