# Copiar a .env y completar. NUNCA versionar .env.

# --- Base de datos (docker-compose.yml) ---
POSTGRES_USER=liga
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=liga_quero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://liga:cambiar-esta-clave@localhost:5432/liga_quero
# Base de datos SOLO para pruebas de integración. El nombre debe terminar en _test;
# las pruebas la crean, migran y vacían, y se niegan a usar cualquier otra.
TEST_DATABASE_URL=postgresql://liga:cambiar-esta-clave@localhost:5432/liga_quero_test

# --- API ---
NODE_ENV=development
API_PORT=3000
# Orígenes permitidos por CORS, separados por coma
WEB_ORIGIN=http://localhost:5173

# --- Seguridad y sesiones (ver docs/authentication.md) ---
# Secreto para hashes con clave (IP, correos en intentos fallidos). Mínimo 32 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECURITY_HASH_KEY=cambiar-este-valor-por-un-secreto-largo-y-aleatorio
# Saltos de proxy inverso de confianza (0 = acceso directo, sin proxy)
TRUST_PROXY=0
# Inactividad máxima y duración máxima de una sesión
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Vigencia de los enlaces de activación / restablecimiento de contraseña
CREDENTIAL_LINK_TTL_HOURS=24
# Limitación de intentos de inicio de sesión fallidos dentro de la ventana
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=50
